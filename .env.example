# Copy to .env and fill in real values. Never commit .env.
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Required. Flask session signing key. App refuses to boot without it.
SECRET_KEY=

# Optional. Database URL. Defaults to sqlite:///food_ordering.db next to app.py.
DATABASE_URL=

# Optional. Set to 1 for local development only. Never enable in production.
FLASK_DEBUG=0

# Optional. Set to 0 only for plain-HTTP local development.
# Keep 1 (default) whenever serving over HTTPS.
SESSION_COOKIE_SECURE=1

# Used only by scripts/create_admin.py to create the first admin account.
ADMIN_USERNAME=
ADMIN_PASSWORD=
